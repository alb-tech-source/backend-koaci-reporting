generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id                    String            @id @default(uuid())
  firstname                  String?
  lastname                   String?
  email                      String            @unique
  password                   String
  reset_token                String?
  reset_token_expires        DateTime?
  is_active                  Boolean           @default(false)
  last_login_at              DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  googleId                   String?
  activityLogs               ActivityLog[]
  companyDocument            CompanyDocument[]
  investor                   Investor?
  role                       Role?
  email_verified             Boolean           @default(false)
  email_verification_token   String?
  email_verification_expires String?
}

model Role {
  role_id         String           @id @default(uuid())
  user_id         String           @unique
  role_name       RoleName
  user            User             @relation(fields: [user_id], references: [user_id])
  rolePermissions RolePermission[]
}

model ActivityLog {
  activity_id String         @id @default(uuid())
  user_id     String
  action      ActivityAction
  entity_type String
  entity_id   String
  description String
  metadata    Json?
  ip_address  String?
  user_agent  String?
  timestamp   DateTime       @default(now())
  user        User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([timestamp])
}

model Permission {
  permission_id   String           @id @default(uuid())
  permission_key  String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [permission_id])
  role          Role       @relation(fields: [role_id], references: [role_id])

  @@id([role_id, permission_id])
}

model Investor {
  investor_id         String             @id @default(uuid())
  user_id             String             @unique
  investor_type       InvestorType
  status              InvestorStatus     @default(inactive)
  gender              Gender
  nik                 String
  address             String
  privy               String?
  phone               String
  account_number      String
  bank_name           String
  heir_name           String?
  heir_relationship   String?
  heir_nik            String?
  heir_address        String?
  heir_account_number String?
  heir_bank_name      String?
  heir_phone          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [user_id], references: [user_id])
  InvestorDocument    InvestorDocument[]
}

model InvestorDocument {
  document_id      String          @id @default(uuid())
  investor_id      String
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_at      DateTime        @default(now())
  investor         Investor        @relation(fields: [investor_id], references: [investor_id])
}

model Company {
  company_id             String            @id @default(uuid())
  company_name           String
  company_type           CompanyType       @default(PT)
  industry_sector        String?
  description            String?
  director_name          String
  director_phone         String
  company_email          String?
  director_privy         String?
  company_address        String
  website                String?
  heirs_director_name    String?
  heirs_director_phone   String?
  heirs_director_address String?
  status                 CompanyStatus     @default(active)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  companyDocument        CompanyDocument[]
}

model CompanyDocument {
  document_id      String          @id @default(uuid())
  company_id       String
  document_type    String?
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_by      String
  uploaded_at      DateTime        @default(now())

  company Company @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  user    User    @relation(fields: [uploaded_by], references: [user_id])

  @@index([company_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

enum CompanyType {
  PT
  CV
  Firma
  Perorangan
}

enum RoleName {
  bod
  admin
  investor
  user
  superadmin
}

enum InvestorType {
  individual
  corporation
}

enum InvestorStatus {
  active
  inactive
  blacklist
}

enum CompanyStatus {
  active
  inactive
  blacklist
}

enum Gender {
  men
  women
}

enum StorageProvider {
  cloudflare
  tencent
  aws
}

enum ActivityAction {
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  USER_RESET_PASSWORD
  INVESTOR_CREATE
  INVESTOR_UPDATE
  INVESTOR_DELETE
  INVESTOR_STATUS_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGE
  PERMISSION_CREATE
  PERMISSION_UPDATE
  PERMISSION_DELETE
  COMPANY_CREATE
  COMPANY_UPDATE
  COMPANY_DELETE
  COMPANY_DOCUMENT_UPLOAD
  COMPANY_DOCUMENT_UPDATE
  COMPANY_DOCUMENT_DELETE
}
