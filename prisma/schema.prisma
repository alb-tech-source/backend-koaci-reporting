generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id                    String            @id @default(uuid())
  firstname                  String?
  lastname                   String?
  email                      String            @unique
  password                   String
  reset_token                String?
  reset_token_expires        DateTime?
  is_active                  Boolean           @default(false)
  last_login_at              DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  googleId                   String?
  activityLogs               ActivityLog[]
  companyDocument            CompanyDocument[]
  projectDocument            ProjectDocument[]
  investor                   Investor?
  role                       Role?

  receiptDocuments           ReceiptDocument[]
  projectReportingSubmitted  ProjectReporting[]       @relation("ProjectReportingSubmittedBy")
  projectReportingUpdated    ProjectReporting[]       @relation("ProjectReportingUpdatedBy")
  projectReportingMedia      ProjectReportingMedia[]

  email_verified             Boolean           @default(false)
  email_verification_token   String?
  email_verification_expires String?
}

model Role {
  role_id         String           @id @default(uuid())
  user_id         String           @unique
  role_name       RoleName
  user            User             @relation(fields: [user_id], references: [user_id])
  rolePermissions RolePermission[]
}

model ActivityLog {
  activity_id String         @id @default(uuid())
  user_id     String
  action      ActivityAction
  entity_type String
  entity_id   String
  description String
  metadata    Json?
  ip_address  String?
  user_agent  String?
  timestamp   DateTime       @default(now())
  user        User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([timestamp])
}

model Permission {
  permission_id   String           @id @default(uuid())
  permission_key  String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [permission_id])
  role          Role       @relation(fields: [role_id], references: [role_id])

  @@id([role_id, permission_id])
}

model Investor {
  investor_id         String             @id @default(uuid())
  user_id             String             @unique
  investor_type       InvestorType
  status              InvestorStatus     @default(inactive)
  gender              Gender
  nik                 String
  address             String
  privy               String?
  phone               String
  account_number      String
  bank_name           String
  heir_name           String?
  heir_relationship   String?
  heir_nik            String?
  heir_address        String?
  heir_account_number String?
  heir_bank_name      String?
  heir_phone          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [user_id], references: [user_id])

  InvestorDocument    InvestorDocument[]
  projectInvestment   ProjectInvestment[]

  @@index(user_id)
  @@index(status)
  @@index(nik)
}

model InvestorDocument {
  document_id      String          @id @default(uuid())
  investor_id      String
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_at      DateTime        @default(now())
  investor         Investor        @relation(fields: [investor_id], references: [investor_id])
}

model Company {
  company_id             String            @id @default(uuid())
  company_name           String
  company_type           CompanyType       @default(PT)
  industry_sector        String?
  description            String?
  director_name          String
  director_phone         String
  company_email          String?
  director_privy         String?
  company_address        String
  website                String?
  heirs_director_name    String?
  heirs_director_phone   String?
  heirs_director_address String?
  status                 CompanyStatus     @default(active)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  companyDocument        CompanyDocument[]
  project                Project[]
}

model CompanyDocument {
  document_id      String          @id @default(uuid())
  company_id       String
  document_type    String?
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_by      String
  uploaded_at      DateTime        @default(now())

  company Company @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  user    User    @relation(fields: [uploaded_by], references: [user_id])

  @@index([company_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

model Project {
  project_id                                 String         @id @default(uuid())
  project_key                                String         @unique
  company_id                                 String
  funding_required                           Decimal        @db.Decimal(18, 2)
  net_margin_amount                          Decimal?       @db.Decimal(18, 2)
  applicant_profit_share_percentage          Float?
  applicant_profit_share_amount              Decimal?       @db.Decimal(18, 2)
  koaci_profit_share_percentage              Float?
  koaci_profit_share_amount                  Decimal?       @db.Decimal(18, 2)
  koaci_profit_share_beneficiary_percentage  Float?
  koaci_profit_share_beneficiary_amount      Decimal?       @db.Decimal(18, 2)
  investor_profit_share_percentage           Float?
  investor_profit_share_amount               Decimal?       @db.Decimal(18, 2)
  aggregate_fund_amount                      Decimal?       @db.Decimal(18, 2)
  disbursement_amount                        Decimal?       @db.Decimal(18, 2)
  disbursement_date                          DateTime?
  source_account_number                      String?
  destination_account_number                 String?
  beneficiary_refund_date                    DateTime?
  beneficiary_refund_amount                  Decimal?       @db.Decimal(18, 2)
  beneficiary_repayment_source_account       String?
  beneficiary_repayment_destination_account  String?
  url_transaction_folder                     String?
  fund_disbursement_official_record          String?
  status                                     ProjectStatus  @default(open)
  createdAt                                  DateTime       @default(now())
  updatedAt                                  DateTime       @updatedAt

  company         Company          @relation(fields: [company_id], references: [company_id])
  projectDocument ProjectDocument[]
  projectInvestment ProjectInvestment[]
  projectReporting  ProjectReporting[]

  @@index([company_id])
  @@index([status])
}

model ProjectDocument {
  document_id      String          @id @default(uuid())
  project_id       String
  document_type    String?
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_by      String
  uploaded_at      DateTime        @default(now())

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user    User    @relation(fields: [uploaded_by], references: [user_id])

  @@index([project_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

model ProjectInvestment {
  project_investment_id       String    @id   @default(uuid())
  project_id                  String
  investor_id                 String
  amount                      Decimal        @db.Decimal(18, 2)
  total_package               Int
  source_account_transaction  String?
  account_reference           String?
  receipt_number              String?
  payment_method              PaymentMethod
  destination_account_number  String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  project   Project     @relation(fields: [project_id], references: [project_id], onDelete: NoAction)
  investor  Investor    @relation(fields: [investor_id], references: [investor_id], onDelete: NoAction)

  receiptDocument   ReceiptDocument?

  @@index(project_id)
  @@index(investor_id)
}

model ReceiptDocument {
  receipt_document_id     String   @id   @default(uuid())
  project_investment_id   String          @unique
  receipt_name            String
  storage_provider        StorageProvider @default(cloudflare)
  object_key              String
  file_size_bytes         BigInt?
  mime_type               String?
  uploaded_by             String
  uploaded_at             DateTime        @default(now())

  projectInvestment ProjectInvestment   @relation(fields: [project_investment_id], references: [project_investment_id])
  user    User    @relation(fields: [uploaded_by], references: [user_id])

  @@index(project_investment_id)
}

model ProjectReporting {
  project_reporting_id          String    @id   @default(uuid())
  project_id                    String
  report_date                   DateTime
  estimate_progress_percentage  Float?
  narative_summary              String  @db.Text
  issues_blockers               String?  @db.Text
  next_week_plan                String?  @db.Text
  fund_disbursed                Decimal?  @db.Decimal(18, 2)
  submitted_by                  String
  updated_by                    String?
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  project          Project  @relation(fields: [project_id], references: [project_id])
  submitted        User     @relation("ProjectReportingSubmittedBy", fields: [submitted_by], references: [user_id])
  updated          User?    @relation("ProjectReportingUpdatedBy", fields: [updated_by], references: [user_id])
  projectReportingMedia ProjectReportingMedia[]

  @@index(project_id)
  @@index(report_date)
  @@index(submitted_by)
  @@index(updated_by)
}

model ProjectReportingMedia {
  project_reporting_media_id  String    @id   @default(uuid())
  project_reporting_id        String
  media_type                  ProjectMedia
  media_name                  String
  storage_provider            StorageProvider @default(cloudflare)
  object_key                  String
  file_size_bytes             BigInt?
  mime_type                   String?
  uploaded_by                 String
  uploaded_at                 DateTime  @default(now())

  projectReporting      ProjectReporting    @relation(fields: [project_reporting_id], references: [project_reporting_id])
  user                  User                @relation(fields: [uploaded_by], references: [user_id])

  @@index(project_reporting_id)
}

enum ProjectMedia {
  photo
  video
  document
}

enum PaymentMethod{
  cash
  transfer
}

enum CompanyType {
  PT
  CV
  Firma
  Perorangan
}

enum RoleName {
  bod
  admin
  investor
  user
  superadmin
}

enum InvestorType {
  individual
  corporation
}

enum InvestorStatus {
  active
  inactive
  blacklist
}

enum CompanyStatus {
  active
  inactive
  blacklist
}

enum ProjectStatus {
  open
  closed
  target_achieved
  cancelled
}

enum Gender {
  men
  women
}

enum StorageProvider {
  cloudflare
  tencent
  aws
}

enum ActivityAction {
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  USER_RESET_PASSWORD
  INVESTOR_CREATE
  INVESTOR_UPDATE
  INVESTOR_DELETE
  INVESTOR_STATUS_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGE
  PERMISSION_CREATE
  PERMISSION_UPDATE
  PERMISSION_DELETE
  COMPANY_CREATE
  COMPANY_UPDATE
  COMPANY_DELETE
  COMPANY_DOCUMENT_UPLOAD
  COMPANY_DOCUMENT_UPDATE
  COMPANY_DOCUMENT_DELETE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_DOCUMENT_UPLOAD
  PROJECT_DOCUMENT_UPDATE
  PROJECT_DOCUMENT_DELETE
  PROJECT_INVESTMENT_CREATE
  PROJECT_INVESTMENT_UPDATE
  PROJECT_INVESTMENT_DELETE
  RECEIPT_DOCUMENT_UPLOAD
  RECEIPT_DOCUMENT_DELETE
  PROJECT_REPORTING_CREATE
  PROJECT_REPORTING_UPDATE
  PROJECT_REPORTING_DELETE
  PROJECT_REPORTING_MEDIA_UPLOAD
  PROJECT_REPORTING_MEDIA_UPDATE
  PROJECT_REPORTING_MEDIA_DELETE
}
