generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id             String            @id @default(uuid())
  firstname           String?
  lastname            String?
  email               String            @unique
  password            String
  reset_token         String?
  reset_token_expires DateTime?
  is_active           Boolean           @default(false)
  last_login_at       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  googleId            String?
  activityLogs        ActivityLog[]
  companyDocument     CompanyDocument[]
  projectDocument     ProjectDocument[]
  investor            Investor?
  role                Role?

  receiptDocuments           ReceiptDocument[]
  projectReportingSubmitted  ProjectReporting[]      @relation("ProjectReportingSubmittedBy")
  projectReportingUpdated    ProjectReporting[]      @relation("ProjectReportingUpdatedBy")
  projectReportingMedia      ProjectReportingMedia[]
  projectSettlementCreated   ProjectSettlement[]     @relation("projectSettlementCreated")
  projectSettlementApproved  ProjectSettlement[]     @relation("projectSettlementApproved")
  investorSettlementCreated  InvestorSettlement[]    @relation("investorSettlementCreated")
  investorSettlementApproved InvestorSettlement[]    @relation("investorSettlementApproved")

  email_verified             Boolean @default(false)
  email_verification_token   String?
  email_verification_expires String?
}

model Role {
  role_id         String           @id @default(uuid())
  user_id         String           @unique
  role_name       RoleName
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  rolePermissions RolePermission[]
}

model ActivityLog {
  activity_id String         @id @default(uuid())
  user_id     String
  action      ActivityAction
  entity_type String
  entity_id   String
  description String
  metadata    Json?
  ip_address  String?
  user_agent  String?
  timestamp   DateTime       @default(now())
  user        User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([timestamp])
}

model Permission {
  permission_id   String   @id @default(uuid())
  permission_key  String   @unique
  default_of_role String[]

  rolePermissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model Investor {
  investor_id         String         @id @default(uuid())
  user_id             String         @unique
  investor_type       InvestorType
  status              InvestorStatus @default(inactive)
  gender              Gender
  nik                 String
  address             String
  privy               String?
  phone               String
  account_number      String
  bank_name           String
  heir_name           String?
  heir_relationship   String?
  heir_nik            String?
  heir_address        String?
  heir_account_number String?
  heir_bank_name      String?
  heir_phone          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [user_id], references: [user_id])

  InvestorDocument   InvestorDocument[]
  projectInvestment  ProjectInvestment[]
  investorSettlement InvestorSettlement[]

  @@index(user_id)
  @@index(status)
  @@index(nik)
}

model InvestorDocument {
  document_id      String          @id @default(uuid())
  investor_id      String
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_at      DateTime        @default(now())

  investor Investor @relation(fields: [investor_id], references: [investor_id], onDelete: Cascade)
}

model Company {
  company_id             String            @id @default(uuid())
  company_name           String
  company_type           CompanyType       @default(PT)
  industry_sector        String?
  description            String?
  director_name          String
  director_phone         String
  company_email          String?
  director_privy         String?
  company_address        String
  website                String?
  heirs_director_name    String?
  heirs_director_phone   String?
  heirs_director_address String?
  status                 CompanyStatus     @default(active)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  companyDocument        CompanyDocument[]
  project                Project[]
}

model CompanyDocument {
  document_id      String          @id @default(uuid())
  company_id       String
  document_type    String?
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_by      String
  uploaded_at      DateTime        @default(now())
  is_shared        Boolean         @default(false)

  company Company @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  user    User    @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction)

  @@index([company_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

model Project {
  project_id                                String        @id @default(uuid())
  project_key                               String        @unique
  project_name                              String?
  company_id                                String
  funding_required                          Decimal       @db.Decimal(18, 2)
  net_margin_amount                         Decimal?      @db.Decimal(18, 2)
  disbursement_amount                       Decimal?      @db.Decimal(18, 2)
  disbursement_date                         DateTime?
  source_account_number                     String?
  destination_account_number                String?
  beneficiary_refund_date                   DateTime?
  beneficiary_refund_amount                 Decimal?      @db.Decimal(18, 2)
  beneficiary_repayment_source_account      String?
  beneficiary_repayment_destination_account String?
  url_transaction_folder                    String?
  fund_disbursement_official_record         String?
  status                                    ProjectStatus @default(open)
  is_public                                 Boolean       @default(false)
  createdAt                                 DateTime      @default(now())
  updatedAt                                 DateTime      @updatedAt

  company           Company             @relation(fields: [company_id], references: [company_id], onDelete: NoAction)
  projectDocument   ProjectDocument[]
  projectInvestment ProjectInvestment[]
  projectReporting  ProjectReporting[]
  projectSettlement ProjectSettlement?

  @@index([company_id])
  @@index([status])
}

model ProjectDocument {
  document_id      String          @id @default(uuid())
  project_id       String
  document_type    String?
  document_name    String
  storage_provider StorageProvider @default(cloudflare)
  object_key       String
  file_size_bytes  BigInt?
  mime_type        String?
  uploaded_by      String
  uploaded_at      DateTime        @default(now())
  is_shared        Boolean         @default(false)

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user    User    @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction)

  @@index([project_id])
  @@index([uploaded_by])
  @@index([uploaded_at])
}

model ProjectInvestment {
  project_investment_id      String        @id @default(uuid())
  project_id                 String
  investor_id                String
  amount                     Decimal       @db.Decimal(18, 2)
  total_package              Int
  source_account_transaction String?
  account_reference          String?
  receipt_number             String?
  payment_method             PaymentMethod
  destination_account_number String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  project  Project  @relation(fields: [project_id], references: [project_id], onDelete: NoAction)
  investor Investor @relation(fields: [investor_id], references: [investor_id], onDelete: NoAction)

  receiptDocument ReceiptDocument?

  @@index(project_id)
  @@index(investor_id)
}

model ReceiptDocument {
  receipt_document_id   String          @id @default(uuid())
  project_investment_id String          @unique
  receipt_name          String
  storage_provider      StorageProvider @default(cloudflare)
  object_key            String
  file_size_bytes       BigInt?
  mime_type             String?
  uploaded_by           String
  uploaded_at           DateTime        @default(now())

  projectInvestment ProjectInvestment @relation(fields: [project_investment_id], references: [project_investment_id], onDelete: Cascade)
  user              User              @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction)

  @@index(project_investment_id)
}

model ProjectReporting {
  project_reporting_id         String   @id @default(uuid())
  project_id                   String
  report_date                  DateTime
  estimate_progress_percentage Float?
  narative_summary             String   @db.Text
  issues_blockers              String?  @db.Text
  next_week_plan               String?  @db.Text
  fund_disbursed               Decimal? @db.Decimal(18, 2)
  submitted_by                 String
  updated_by                   String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  project               Project                 @relation(fields: [project_id], references: [project_id], onDelete: NoAction)
  submitted             User                    @relation("ProjectReportingSubmittedBy", fields: [submitted_by], references: [user_id], onDelete: NoAction)
  updated               User?                   @relation("ProjectReportingUpdatedBy", fields: [updated_by], references: [user_id], onDelete: NoAction)
  projectReportingMedia ProjectReportingMedia[]

  @@index(project_id)
  @@index(report_date)
  @@index(submitted_by)
  @@index(updated_by)
}

model ProjectReportingMedia {
  project_reporting_media_id String          @id @default(uuid())
  project_reporting_id       String
  media_type                 ProjectMedia
  media_name                 String
  storage_provider           StorageProvider @default(cloudflare)
  object_key                 String
  file_size_bytes            BigInt?
  mime_type                  String?
  uploaded_by                String
  uploaded_at                DateTime        @default(now())

  projectReporting ProjectReporting @relation(fields: [project_reporting_id], references: [project_reporting_id], onDelete: Cascade)
  user             User             @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction)

  @@index(project_reporting_id)
}

// Semua *_pct disimpan dalam satuan persen 0-100 (mis. 40 = 40%) bertipe Decimal.
// Seluruh field hasil hitung diisi backend (lihat src/modules/projectSettlement/settlement.calculator.ts).
model ProjectSettlement {
  project_settlement_id   String                  @id @default(uuid())
  project_id              String                  @unique
  profit_model            String // jual beli, bagi hasil pendapatan
  total_capital           Decimal                 @db.Decimal(18, 2) // input manual admin
  sales_amount            Decimal                 @db.Decimal(18, 2)
  gross_margin            Decimal                 @db.Decimal(18, 2) // (sales_amount - total_capital)
  other_cost              Decimal                 @default(0) @db.Decimal(18, 2)
  other_cost_description  String                  @default("") @db.Text
  net_profit_margin       Decimal                 @db.Decimal(18, 2) // (gross_margin - other_cost)
  applicant_share_pct     Decimal                 @db.Decimal(7, 4) // applicant_share_pct + koaci_share_pct = 100
  applicant_share_amount  Decimal                 @db.Decimal(18, 2) // (net_profit_margin x applicant_share_pct / 100)
  koaci_share_pct         Decimal                 @db.Decimal(7, 4)
  koaci_share_amount      Decimal                 @db.Decimal(18, 2) // (net_profit_margin - applicant_share_amount)
  koaci_portion_pct       Decimal                 @db.Decimal(7, 4) // koaci_portion_pct + investor_portion_pct = 100
  koaci_portion_amount    Decimal                 @db.Decimal(18, 2) // (koaci_share_amount - investor_portion_amount)
  investor_portion_pct    Decimal                 @db.Decimal(7, 4)
  investor_portion_amount Decimal                 @db.Decimal(18, 2) // (koaci_share_amount x investor_portion_pct / 100)
  compensation_total      Decimal?                @db.Decimal(18, 2) // (SUM InvestorSettlement.compensation_amount)
  koaci_final_profit      Decimal?                @db.Decimal(18, 2) // (koaci_portion_amount - compensation_total)
  status                  ProjectSettlementStatus @default(review)
  created_by              String
  approved_by             String?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt

  project    Project @relation(fields: [project_id], references: [project_id], onDelete: Restrict)
  createdBy  User    @relation("projectSettlementCreated", fields: [created_by], references: [user_id], onDelete: Restrict)
  approvedBy User?   @relation("projectSettlementApproved", fields: [approved_by], references: [user_id], onDelete: SetNull)

  investorSettlement InvestorSettlement[]

  @@index(status)
}

model InvestorSettlement {
  investor_settlement_id String                   @id @default(uuid())
  project_settlement_id  String
  investor_id            String
  principal_amount       Decimal                  @db.Decimal(18, 2) // (SUM amount ProjectInvestment investor pada project)
  modal_portion_pct      Decimal                  @db.Decimal(12, 6) // ((principal_amount / total_capital) x 100)
  profit_share_amount    Decimal                  @db.Decimal(18, 2) // (investor_portion_amount x modal_portion_pct / 100)
  compensation_pct       Decimal                  @default(0) @db.Decimal(7, 4)
  compensation_amount    Decimal                  @default(0) @db.Decimal(18, 2) // (principal_amount x compensation_pct / 100)
  total_profit           Decimal                  @db.Decimal(18, 2) // (profit_share_amount + compensation_amount)
  status                 InvestorSettlementStatus @default(pending)
  created_by             String
  approved_by            String?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  projectSettlement ProjectSettlement @relation(fields: [project_settlement_id], references: [project_settlement_id], onDelete: Restrict)
  investor          Investor          @relation(fields: [investor_id], references: [investor_id], onDelete: Restrict)
  createdBy         User              @relation("investorSettlementCreated", fields: [created_by], references: [user_id], onDelete: Restrict)
  approvedBy        User?             @relation("investorSettlementApproved", fields: [approved_by], references: [user_id], onDelete: SetNull)

  @@unique([project_settlement_id, investor_id])
  @@index(investor_id)
}

enum InvestorSettlementStatus {
  pending
  approved
  rejected
}

enum ProjectSettlementStatus {
  review
  approved
  rejected
}

enum ProjectMedia {
  photo
  video
  document
}

enum PaymentMethod {
  cash
  transfer
}

enum CompanyType {
  PT
  CV
  Firma
  Perorangan
}

enum RoleName {
  bod
  admin
  investor
  user
  superadmin
}

enum InvestorType {
  individual
  corporation
}

enum InvestorStatus {
  active
  inactive
  blacklist
}

enum CompanyStatus {
  active
  inactive
  blacklist
}

enum ProjectStatus {
  open
  closed
  target_achieved
  cancelled
}

enum Gender {
  men
  women
}

enum StorageProvider {
  cloudflare
  tencent
  aws
}

enum ActivityAction {
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE
  USER_RESET_PASSWORD
  INVESTOR_CREATE
  INVESTOR_UPDATE
  INVESTOR_DELETE
  INVESTOR_STATUS_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGE
  PERMISSION_CREATE
  PERMISSION_UPDATE
  PERMISSION_DELETE
  COMPANY_CREATE
  COMPANY_UPDATE
  COMPANY_DELETE
  COMPANY_DOCUMENT_UPLOAD
  COMPANY_DOCUMENT_UPDATE
  COMPANY_DOCUMENT_DELETE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_DOCUMENT_UPLOAD
  PROJECT_DOCUMENT_UPDATE
  PROJECT_DOCUMENT_DELETE
  PROJECT_INVESTMENT_CREATE
  PROJECT_INVESTMENT_UPDATE
  PROJECT_INVESTMENT_DELETE
  RECEIPT_DOCUMENT_UPLOAD
  RECEIPT_DOCUMENT_DELETE
  PROJECT_REPORTING_CREATE
  PROJECT_REPORTING_UPDATE
  PROJECT_REPORTING_DELETE
  PROJECT_REPORTING_MEDIA_UPLOAD
  PROJECT_REPORTING_MEDIA_UPDATE
  PROJECT_REPORTING_MEDIA_DELETE
  PROJECT_SETTLEMENT_CREATE
  PROJECT_SETTLEMENT_UPDATE
  PROJECT_SETTLEMENT_DELETE
  PROJECT_SETTLEMENT_APPROVE
  PROJECT_SETTLEMENT_REJECT
  INVESTOR_SETTLEMENT_CREATE
  INVESTOR_SETTLEMENT_UPDATE
  INVESTOR_SETTLEMENT_DELETE
  INVESTOR_SETTLEMENT_APPROVE
  INVESTOR_SETTLEMENT_REJECT
}
