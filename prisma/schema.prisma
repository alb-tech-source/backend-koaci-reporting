// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  user
  investor
  admin
  superadmin
  bod
}

enum InvestorType {
  individual
  corporation
}

enum InvestorStatus {
  active
  inactive
  blacklist
}

enum Gender {
  men
  women
}

enum StorageProvider {
  cloudflare
  tencent
  aws
}

model User {
  user_id             String    @id @default(uuid())
  firstname           String?
  lastname            String?
  email               String    @unique
  password            String
  reset_token         String?
  reset_token_expires DateTime?
  is_active           Boolean   @default(false)
  last_login_at       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role                Role?
  investor            Investor?
}

model Role {
  role_id   String   @id @default(uuid())
  user_id   String   @unique          
  role_name RoleName

  user      User     @relation(fields: [user_id], references: [user_id])
  
  rolePermissions RolePermission[]
}

model Permission {
  permission_id   String    @id @default(uuid())
  permission_key  String

  rolePermissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [role_id])
  permission Permission @relation(fields: [permission_id], references: [permission_id])

  @@id([role_id, permission_id])   // composite primary key, wajib biar model valid
}

model Investor {
  investor_id       String  @id @default(uuid())
  user_id           String  @unique
  investor_type     InvestorType
  status            InvestorStatus @default(inactive)
  gender            Gender
  nik               String
  address           String
  privy             String?
  phone             String
  account_number    String
  bank_name         String
  heir_name         String?
  heir_relationship String?
  heir_nik          String?
  heir_address      String?
  heir_account_number   String?
  heir_bank_name    String?
  heir_phone        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User     @relation(fields: [user_id], references: [user_id])

  InvestorDocument  InvestorDocument[]
}

model InvestorDocument {
  document_id       String   @id  @default(uuid())
  investor_id       String
  document_name     String     
  storage_provider  StorageProvider  @default(cloudflare)
  object_key        String
  file_size_bytes   BigInt?
  mime_type         String?
  uploaded_at       DateTime  @default(now())

  investor          Investor  @relation(fields: [investor_id], references: [investor_id])
}

